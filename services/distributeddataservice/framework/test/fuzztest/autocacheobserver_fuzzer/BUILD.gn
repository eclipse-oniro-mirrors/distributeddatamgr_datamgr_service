import("//build/test.gni")
import("//foundation/distributeddatamgr/datamgr_service/datamgr_service.gni")

ohos_fuzztest("AutoCacheObserverFuzzTest") {
  module_out_path = "datamgr_service/datamgr_service"
  include_dirs = [ "${data_service_path}/framework/include" ]
  fuzz_config_file =
      "${data_service_path}/framework/test/fuzztest/autocacheobserver_fuzzer"
  sources = [ "autocacheobserver_fuzzer.cpp" ]
  cflags = [ "-Werror=vla" ]
  deps = [ "${data_service_path}/framework:distributeddatasvcfwk" ]
  external_deps = [
    "c_utils:utils",
    "hilog:libhilog",
    "json:nlohmann_json_static",
    "kv_store:datamgr_common",
  ]
}

group("fuzztest") {
  testonly = true
  deps = [ ":AutoCacheObserverFuzzTest" ]
}
