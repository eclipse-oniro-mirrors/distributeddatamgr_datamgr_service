import("//build/test.gni")
import("//foundation/distributeddatamgr/datamgr_service/datamgr_service.gni")

module_output_path = "datamgr_service/datamgr_service/distributeddatafwk"

ohos_unittest("SecurityGuardDelegateTest") {
  testonly = true
  module_out_path = module_output_path
  sources = [
    "${data_service_path}/adapter/security_guard/src/security_guard_delegate_impl.cpp",
    "${data_service_path}/framework/security_guard/security_guard_delegate.cpp",
    "security_guard_delegate_impl_test.cpp",
    "security_guard_log_limiter_test.cpp",
  ]
  include_dirs = [
    "${data_service_path}/adapter/security_guard/src",
    "${data_service_path}/framework/include",
  ]
  external_deps = [
    "c_utils:utils",
    "hilog:libhilog",
    "kv_store:datamgr_common",
  ]
}

ohos_unittest("SecurityGuardDelegateDefaultTest") {
  testonly = true
  module_out_path = module_output_path
  sources = [
    "${data_service_path}/adapter/security_guard/src/security_guard_delegate_default_impl.cpp",
    "${data_service_path}/framework/security_guard/security_guard_delegate.cpp",
    "security_guard_delegate_default_impl_test.cpp",
  ]
  include_dirs = [
    "${data_service_path}/adapter/security_guard/src",
    "${data_service_path}/framework/include",
  ]
  external_deps = [
    "c_utils:utils",
    "kv_store:datamgr_common",
  ]
}

if (udmf_security_guard_enabled) {
  ohos_unittest("SecurityGuardDelegateNormalTest") {
    testonly = true
    module_out_path = module_output_path
    sources = [
      "${data_service_path}/adapter/security_guard/src/security_guard_delegate_impl.cpp",
      "${data_service_path}/adapter/security_guard/src/security_guard_delegate_normal_impl.cpp",
      "${data_service_path}/framework/security_guard/security_guard_delegate.cpp",
      "mock/security_guard_sdk_mock.cpp",
      "security_guard_delegate_normal_impl_test.cpp",
    ]
    include_dirs = [
      "${data_service_path}/adapter/security_guard/src",
      "${data_service_path}/framework/include",
    ]
    external_deps = [
      "c_utils:utils",
      "googletest:gmock",
      "hilog:libhilog",
      "ipc:ipc_core",
      "kv_store:datamgr_common",
      "security_guard:libsg_collect_sdk",
    ]
  }
}

group("unittest") {
  testonly = true
  deps = [
    ":SecurityGuardDelegateDefaultTest",
    ":SecurityGuardDelegateTest",
  ]
  if (udmf_security_guard_enabled) {
    deps += [ ":SecurityGuardDelegateNormalTest" ]
  }
}
