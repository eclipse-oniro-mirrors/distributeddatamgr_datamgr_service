import("//build/ohos.gni")
import("//foundation/distributeddatamgr/datamgr_service/datamgr_service.gni")

ohos_source_set("distributeddata_security_guard") {
  branch_protector_ret = "pac_ret"
  sanitize = {
    cfi = true
    cfi_cross_dso = true
    debug = false
    boundary_sanitize = true
    ubsan = true
  }
  include_dirs = [
    "src",
    "${data_service_path}/framework/include",
  ]
  deps = [ "${data_service_path}/framework:distributeddatasvcfwk" ]
  external_deps = [ "kv_store:datamgr_common" ]
  cflags_cc = [
    "-fvisibility=hidden",
    "-Werror=vla",
  ]
  if (udmf_security_guard_enabled) {
    sources = [
      "src/security_guard_delegate_impl.cpp",
      "src/security_guard_delegate_normal_impl.cpp",
    ]
    external_deps += [
      "c_utils:utils",
      "hilog:libhilog",
      "ipc:ipc_core",
      "security_guard:libsg_collect_sdk",
    ]
  } else {
    sources = [ "src/security_guard_delegate_default_impl.cpp" ]
  }
  subsystem_name = "distributeddatamgr"
  part_name = "datamgr_service"
}
