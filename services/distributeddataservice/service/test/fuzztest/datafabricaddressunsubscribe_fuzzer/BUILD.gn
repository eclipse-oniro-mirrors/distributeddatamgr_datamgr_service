##############################hydra-fuzz########################################
import("//build/config/features.gni")
import("//build/test.gni")
import("//foundation/distributeddatamgr/datamgr_service/datamgr_service.gni")

##############################fuzztest##########################################
ohos_fuzztest("DataFabricAddressUnsubscribeFuzzTest") {
  module_out_path = "datamgr_service/datamgr_service"

  fuzz_config_file =
      "${data_service_path}/service/test/fuzztest/datafabricaddressunsubscribe_fuzzer"

  cflags = [
    "-g",
    "-O0",
    "-Wno-unused-variable",
    "-Wno-unused-parameter",
    "-fno-omit-frame-pointer",
  ]

  include_dirs = [
    "${data_service_path}/framework/include",
    "${data_service_path}/framework/include/feature",
    "${data_service_path}/service/data_fabric_address",
    "${data_service_path}/service/test/fuzztest/common/datafabricaddresscommon_fuzzer",
  ]

  sources = [
    "${data_service_path}/service/data_fabric_address/data_fabric_address_callback_proxy.cpp",
    "${data_service_path}/service/data_fabric_address/data_fabric_address_service_stub.cpp",
    "${data_service_path}/service/data_fabric_address/data_fabric_address_types_util.cpp",
    "${data_service_path}/service/test/fuzztest/common/datafabricaddresscommon_fuzzer/datafabricaddresscommon_fuzzer.cpp",
    "datafabricaddressunsubscribe_fuzzer.cpp",
  ]

  deps = [
    "${data_service_path}/framework:distributeddatasvcfwk",
  ]

  external_deps = [
    "access_token:libaccesstoken_sdk",
    "access_token:libtokenid_sdk",
    "c_utils:utils",
    "hilog:libhilog",
    "init:libbegetutil",
    "ipc:ipc_core",
    "ipc:ipc_single",
    "kv_store:datamgr_common",
    "preferences:native_preferences",
  ]
}

###############################################################################
group("fuzztest") {
  testonly = true

  deps = [ ":DataFabricAddressUnsubscribeFuzzTest" ]
}
###############################################################################
