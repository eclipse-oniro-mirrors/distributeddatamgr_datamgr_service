import("//build/ohos_var.gni")
import("//build/test.gni")
import("//foundation/distributeddatamgr/datamgr_service/datamgr_service.gni")

module_output_path = "datamgr_service/datamgr_service/service/data_fabric_address"

module_private_config = "${data_service_path}/service/test:module_private_config"

###############################################################################
# Data Fabric Address Service Unit Tests (Stub + Impl)
###############################################################################

ohos_unittest("DataFabricAddressServiceTest") {
  module_out_path = module_output_path

  include_dirs = [
    "${data_service_path}/service/data_fabric_address",
    "${data_service_path}/service/data_fabric_address/navigation/include",
    "${data_service_path}/framework/include/feature",
    "${data_service_path}/service/test/mock",
  ]

  sources = [
    "${data_service_path}/service/data_fabric_address/data_fabric_address_callback_proxy.cpp",
    "${data_service_path}/service/data_fabric_address/data_fabric_address_service_impl.cpp",
    "${data_service_path}/service/data_fabric_address/data_fabric_address_service_stub.cpp",
    "${data_service_path}/service/data_fabric_address/data_fabric_address_types_util.cpp",
    "../../mock/access_token_mock.cpp",
    "data_fabric_address_callback_proxy_test.cpp",
    "data_fabric_address_service_impl_test.cpp",
    "data_fabric_address_service_stub_test.cpp",
    "fakes/navigation_common_utils_fake.cpp",
    "fakes/navigation_manager_fake.cpp",
  ]

  configs = [ module_private_config ]

  deps = [
    "${data_service_path}/framework:distributeddatasvcfwk",
  ]

  external_deps = [
    "access_token:libaccesstoken_sdk",
    "access_token:libtokenid_sdk",
    "c_utils:utils",
    "googletest:gmock_main",
    "googletest:gtest_main",
    "hilog:libhilog",
    "init:libbegetutil",
    "ipc:ipc_core",
    "ipc:ipc_single",
    "kv_store:datamgr_common",
    "location:lbsservice_common",
    "location:locator_sdk",
    "preferences:native_preferences",
    "samgr:samgr_proxy",
  ]

  cflags = [
    "-Wno-unused-parameter",
    "-fno-access-control",
  ]
}

###############################################################################
# Data Fabric Address Navigation Unit Tests
###############################################################################

ohos_unittest("DataFabricAddressNavigationTest") {
  module_out_path = module_output_path

  include_dirs = [
    "${data_service_path}/service/data_fabric_address",
    "${data_service_path}/service/data_fabric_address/navigation/include",
  ]

  sources = [
    "${data_service_path}/service/data_fabric_address/navigation/src/navigation_common_utils.cpp",
    "${data_service_path}/service/data_fabric_address/navigation/src/navigation_manager.cpp",
    "data_fabric_address_navigation_test.cpp",
  ]

  configs = [ module_private_config ]

  deps = [
    "${data_service_path}/framework:distributeddatasvcfwk",
  ]

  external_deps = [
    "c_utils:utils",
    "googletest:gtest_main",
    "hilog:libhilog",
    "ipc:ipc_core",
    "ipc:ipc_single",
    "kv_store:datamgr_common",
    "location:lbsservice_common",
    "location:locator_sdk",
    "preferences:native_preferences",
  ]

  cflags = [
    "-Wno-unused-parameter",
    "-fno-access-control",
  ]
}

###############################################################################
# Data Fabric Address Test Collection Group
###############################################################################

group("unittests") {
  testonly = true

  deps = [
    ":DataFabricAddressNavigationTest",
    ":DataFabricAddressServiceTest",
  ]
}
