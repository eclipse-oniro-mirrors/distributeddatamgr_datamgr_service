import("//build/ohos.gni")

config("data_fabric_address_service_config") {
  visibility = [ ":*" ]
  include_dirs = [
    "navigation/include",
  ]
}

ohos_source_set("data_fabric_address_service") {
  branch_protector_ret = "pac_ret"
  sanitize = {
    ubsan = true
    boundary_sanitize = true
    cfi = true
    cfi_cross_dso = true
    debug = false
  }
  sources = [
    "data_fabric_address_callback_proxy.cpp",
    "data_fabric_address_service_impl.cpp",
    "data_fabric_address_service_stub.cpp",
    "data_fabric_address_types_util.cpp",
    "navigation/src/navigation_common_utils.cpp",
    "navigation/src/navigation_manager.cpp",
  ]
  cflags = [
    "-Werror",
    "-Werror=vla",
    "-Wno-multichar",
    "-D_LIBCPP_HAS_COND_CLOCKWAIT",
    "-Oz",
  ]

  cflags_cc = [
    "-Werror=vla",
    "-Oz",
  ]

  configs = [ ":data_fabric_address_service_config" ]

  deps = [
    "../../framework:distributeddatasvcfwk",
  ]

  external_deps = [
    "access_token:libaccesstoken_sdk",
    "access_token:libtokenid_sdk",
    "c_utils:utils",
    "hilog:libhilog",
    "init:libbegetutil",
    "ipc:ipc_core",
    "ipc:ipc_single",
    "kv_store:datamgr_common",
    "location:locator_sdk",
    "location:lbsservice_common",
    "relational_store:native_rdb",
    "preferences:native_preferences",
    "samgr:samgr_proxy",
  ]

  subsystem_name = "distributeddatamgr"
  part_name = "datamgr_service"
}
